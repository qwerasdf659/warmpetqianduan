    {
      "Key": "VIP_001_DESCRIPTION_1",
      "String": "Rakastaa huonekasveja, on addiktoitunut tositelevisioon ja juo liikaa mustaa kahvia."
    },
    {
      "Key": "VIP_001_DESCRIPTION_2",
      "String": "Hänen lapsuudenkissansa Max oli hänen paras kaverinsa. Hän kuiskasi kissalle kaikki salaisuutensa."
    },
    {
      "Key": "VIP_001_DESCRIPTION_3",
      "String": "Maxin inspiroimana hänestä tuli vegaani nuorena. Hän halusi suojella ja vaalia kaikkia eläimiä."
    },
    {
      "Key": "VIP_001_DESCRIPTION_4",
      "String": "Kun Max menehtyi, hän lupasi ettei ikinä hanki uutta kissaa vaan keskittyisi pelastamaan tarpeessa olevia kissoja. Kahvilassa käynti antaa hänelle säännöllisen annoksen kissarakkautta ja kofeiinia."
    },
    {
      "Key": "VIP_NAME_002",
      "String": "Sarah"
    },
    {
      "Key": "VIP_OCCUPATION_002",
      "String": "2D-artisti"
    },
    {
      "Key": "VIP_002_DESCRIPTION_1",
      "String": "Rakastaa videopelejä, on ystävällinen ja välittävä sekä muistaa aina käyttää paljon emojeja tekstiviesteissään."
    },
    {
      "Key": "VIP_002_DESCRIPTION_2",
      "String": "Hän on aina ollut sisäihminen, on hieman sosiaalisesti jännittynyt ja käyttää aina hattua ja paljon aurinkorasvaa ulkona."
    },
    {
      "Key": "VIP_002_DESCRIPTION_3",
      "String": "Hän oli aiemmin täysin koiraihminen kissa-allergian takia, kunnes hän kävi treffeillä ensimmäistä kertaa kissakahvilassa ja rakastui. Kissoihin, ei treffikumppaniinsa."
    },
    {
      "Key": "VIP_002_DESCRIPTION_4",
      "String": "Hän tarvitsee antihistamiinia kahvilakäynneilleen, mutta tietää aivastuksien olevan halien arvoisia. Silittely ja kissojen kanssa oleminen rauhoittaa hänen ahdistustaan."
    },
    {
      "Key": "VIP_NAME_003",
      "String": "Riley"
    },
    {
      "Key": "VIP_OCCUPATION_003",
      "String": "Baarimikko"
    },
    {
      "Key": "VIP_003_DESCRIPTION_1",
      "String": "Pitää aina pipoa, rakastaa hyvää soijacappuccinoa ja väittää kuolemaansa saakka, että kissat ovat koiria parempia."
    },
    {
      "Key": "VIP_003_DESCRIPTION_2",
      "String": "Rakastaa kasvojensa työntämistä kissojen mahaan ja hänen kaikkien aikojen suosikkiasiansa on se, kun kissat päästävät visertäviä ääniä."
    },
    {
      "Key": "VIP_003_DESCRIPTION_3",
      "String": "Menetti traagisesti rakkaan kissansa Sparklen huoltajuuden sotkuisessa erossa tyttöystävästään."
    },
    {
      "Key": "VIP_003_DESCRIPTION_4",
      "String": "Löytää onnea ja rauhaa kahvilan kissoista ja toivoo kerran avaavansa kissakahvilan, joka on juuri sellainen kuin sinunkin."
    },
    {
      "Key": "VIP_NAME_004",
      "String": "Jun Seo"
    },
    {
      "Key": "VIP_OCCUPATION_004",
      "String": "Graafinen suunnittelija"
    },
    {
      "Key": "VIP_004_DESCRIPTION_1",
      "String": "Jun Seo rakastaa oman t-paitamerkkinsä suunnittelua ja painamista sekä teen juomista ja jalkapallon pelaamista."
    },
    {
      "Key": "VIP_004_DESCRIPTION_2",
      "String": "Hän ei ole koskaan ollut kissaihminen, mutta huomattuaan kuinka suosittuja kissat ovat internetissä, hän tuli kahvilaan oppimaan niistä lisää, jotta voisi lisätä niitä t-paitasuunnitelmiinsa."
    },
    {
      "Key": "VIP_004_DESCRIPTION_3",
      "String": "Hänen tutkimuksensa muuttui pian rakkaudeksi. Monet kissat tunnistavat hänet, syöksyvät häntä kohti ja kehräävät innoissaan, kun hän saapuu."
    },
    {
      "Key": "VIP_004_DESCRIPTION_4",
      "String": "Jun Seo adoptoi äskettäin itselleen vanhan kissa, jotta voisi jatkaa ”tutkimista” mukavasti kotonaan. Hän käy yhä kahvilassa, jotta saisi säännöllisesti teetä ja haleja kissoilta, joita oppi rakastamaan."
    },
    {
      "Key": "VIP_NAME_005",
      "String": "Jordan"
    },
    {
      "Key": "VIP_OCCUPATION_005",
      "String": "Apulaiskeittiömestari"
    },
    {
      "Key": "VIP_005_DESCRIPTION_1",
      "String": "Jordan tekee 60 tunnin työpäiviä ja arvostaa suuresti vapaa-aikaansa. Tähän sisältyy pääosin animen katsomista ja videopelien pelaamista kavereiden kanssa."
    },
    {
      "Key": "VIP_005_DESCRIPTION_2",
      "String": "Jordan tekee paljon töitä pääosin uransa vaatimusten takia, mutta myös maksaakseen opintolainansa ja säästääkseen rahaa, jotta voisi tehdä unelmavisiitin Japaniin!"
    },
    {
      "Key": "VIP_005_DESCRIPTION_3",
      "String": "Vaikka hän onkin kiireinen, hän opiskelee japania ja sai tietää, että kissakahvilat ovat japanilaista alkuperää."
    },
    {
      "Key": "VIP_005_DESCRIPTION_4",
      "String": "Kahvilassa vietetty aika on ainoa aika, jolloin hän todella rentoutuu. Vaikka se alkoikin salaisena paheena, karvaisten kaverien silittämisestä on tullut Jordanin yleisin stressinlievityskeino!"
    },
    {
      "Key": "VIP_NAME_006",
      "String": "Suzy"
    },
    {
      "Key": "VIP_OCCUPATION_006",
      "String": "Meikkitaiteilija"
    },
    {
      "Key": "VIP_006_DESCRIPTION_1",
      "String": "Suzy on skorpioni, joka rakastaa selfieitä ja keskiaikaa koskevien podcastien kuuntelua. Hänen suosikkivärinsä on musta."
    },
    {
      "Key": "VIP_006_DESCRIPTION_2",
      "String": "Hän on itseoppinut meikkitaiteilija, jonka menestys sosiaalisessa mediassa ja rakkaus eläimiin saivat hänet luomaan oman eläinystävällisen meikkibrändin."
    },
    {
      "Key": "VIP_006_DESCRIPTION_3",
      "String": "Hänen oman Pebbles-kissansa inspiroima erikoisuus on rohkea kissansilmä-look. Kissansilmien terävä rajaus on kuin obsidiaanimiekka."
    },
    {
      "Key": "VIP_006_DESCRIPTION_4",
      "String": "Ikävä kyllä Pebbles kuoli äskettäin vanhuuteen, joten Suzy tulee kahvilaan ilmaista wlania, herkullisia juomia ja uusien kissakavereidensa haleja varten."
    },
    {
      "Key": "VIP_NAME_007",
      "String": "Rin"
    },
    {
      "Key": "VIP_OCCUPATION_007",
      "String": "Muusikko"
    },
    {
      "Key": "VIP_007_DESCRIPTION_1",
      "String": "Rin rakastaa karaokea, värjää hiuksensa kaikkiin mahdollisiin väreihin ja on tietysti hulluna kissoihin."
    },
    {
      "Key": "VIP_007_DESCRIPTION_2",
      "String": "Hänen rennot karaoketuokionsa inspiroivat hänet lopulta aloittamaan sooloesityksen nimellä ”Kissat puvuissa”."
    },
    {
      "Key": "VIP_007_DESCRIPTION_3",
      "String": "Rin yrittää saada sanoituksiinsa kaikkea kissoihin liittyvää ja kerää inspiraatiota kirjallisuuden kuuluisista kissoista ja säännöllisistä kahvilavierailuista."
    },
    {
      "Key": "VIP_007_DESCRIPTION_4",
      "String": "Kahvilan kissojen inspiroimana hän kirjoitti ja julkaisi uusimman kappaleensa ”Raapimispuun jännitys”. Se on saanut suosiota paikallisradiossa ja hänestä on tullut tunnettu tähti!"
    },
    {
      "Key": "VIP_NAME_008",
      "String": "Jada"
    },
    {
      "Key": "VIP_OCCUPATION_008",
      "String": "Lääkäriharjoittelija"
    },
    {
      "Key": "VIP_008_DESCRIPTION_1",
      "String": "Jada on huippuarvosanoja saanut oppilas, joka kiiti yliopiston läpi kuin ammattilainen. Hänellä on useita tutkintoja, mutta päätti haluavansa auttaa ihmisiä lääketieteen avulla."
    },
    {
      "Key": "VIP_008_DESCRIPTION_2",
      "String": "Kun hän ei ole töissä, hän rakastaa kirpputoreja, valtavien kahvimäärien juomista ja vapaaehtoisena työskentelemistä eläinsuojeluyhdistyksessä."
    },
    {
      "Key": "VIP_008_DESCRIPTION_3",
      "String": "Jada on ollut aina äärimmäisen kiltti ja ensimmäisenä auttamassa avun tarpeessa olevia, olivat he sitten tuttuja tai tuntemattomia."
    },
    {
      "Key": "VIP_008_DESCRIPTION_4",
      "String": "Hän epäitsekkyytensä ja kiireinen elämäntyylinsä eivät jätä aikaa oman kissan pitämiseen."
    },
    {
      "Key": "VIP_NAME_009",
      "String": "Leon"
    },
    {
      "Key": "VIP_OCCUPATION_009",
      "String": "Ruokakauppias"
    },
    {
      "Key": "VIP_009_DESCRIPTION_1",
      "String": "Leon on eläinten oikeuksien puolustaja. Kun hän ei taistele oikeuden puolesta, hän myy paikallisia tuotteita Pörhön Lähikaupassa."
    },
    {
      "Key": "VIP_009_DESCRIPTION_2",
      "String": "Hänen adoptoimansa Nappi-kissa löydettiin vaikertavana ja pelästyneenä. Nappi oli ollut pitkään hylättynä ja eleli Leonin kaupan alla."
    },
    {
      "Key": "VIP_009_DESCRIPTION_3",
      "String": "Nappi ja Leon nauttivat nyt mukavasta elämästä ja kaupan kaikki vakioasiakkaat tervehtivät molempia kuin vanhoja ystäviä."
    },
    {
      "Key": "VIP_009_DESCRIPTION_4",
      "String": "Leon rakastaa kahvilassa käyntiä ja uusien adoptointien ilon näkemistä. Hän edustaa monia kissoihin liittyviä hyväntekeväisyyksiä ja tulee kahvilaan tukemaan ja mainostamaan niitä!"
    },
