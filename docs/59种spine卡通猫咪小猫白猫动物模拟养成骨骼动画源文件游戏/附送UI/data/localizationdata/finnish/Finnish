      "String": "Luca"
    },
    {
      "Key": "VIP_OCCUPATION_011",
      "String": "Kirjastonhoitaja"
    },
    {
      "Key": "VIP_011_DESCRIPTION_1",
      "String": "Pienestä pitäen kirjoitetusta sanasta haltioitunut Luca on aina ollut kirjallisuuden ympäröimä. Hänen suosikkigenrensä on yliluonnollinen romanssi."
    },
    {
      "Key": "VIP_011_DESCRIPTION_2",
      "String": "Paikallinen kirjastokissa Behemoth on ollut hänen parhaita kavereitaan siitä lähtien, kun hän alkoi työskennellä siellä 16-vuotiaana."
    },
    {
      "Key": "VIP_011_DESCRIPTION_3",
      "String": "Luca kuuroutui parikymppisenä ja hänestä on mukava opettaa viittomakielen tunteja työnsä jälkeen. Behemoth nauttii oppilaiden silityksistä."
    },
    {
      "Key": "VIP_011_DESCRIPTION_4",
      "String": "Yksi oppilaista suositteli kahvilassa käyntiä, ja käynnin jälkeen Luca onkin aloittanut ensimmäisen romaaninsa kirjoittamisen!"
    },
