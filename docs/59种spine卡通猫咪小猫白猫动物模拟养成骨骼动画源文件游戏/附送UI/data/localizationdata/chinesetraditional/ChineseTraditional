    {
      "Key": "VIP_NAME_001",
      "String": "雀莉"
    },
    {
      "Key": "VIP_OCCUPATION_001",
      "String": "生活部落客"
    },
    {
      "Key": "VIP_001_DESCRIPTION_1",
      "String": "喜愛室內植物、對實境節目著迷，且嗜喝大量黑咖啡。"
    },
    {
      "Key": "VIP_001_DESCRIPTION_2",
      "String": "她小時候養的貓麥斯是她最好的朋友。她會把所有的秘密都說給他聽。"
    },
    {
      "Key": "VIP_001_DESCRIPTION_3",
      "String": "受麥斯啟發，她年紀輕輕就成為素食主義者。她希望所有動物都能受到愛護與珍惜。"
    },
    {
      "Key": "VIP_001_DESCRIPTION_4",
      "String": "麥斯去世後，她發誓不再養貓，並轉而將心力花在拯救需要幫助的貓咪。造訪咖啡廳可滿足她對小貓的喜愛，並補充咖啡因需求。"
    },
    {
      "Key": "VIP_NAME_002",
      "String": "莎拉"
    },
    {
      "Key": "VIP_OCCUPATION_002",
      "String": "2D美術設計師"
    },
    {
      "Key": "VIP_002_DESCRIPTION_1",
      "String": "喜愛玩電動遊戲，是非常善良且有愛心的人，傳簡訊時一定要加上一堆表情符號。"
    },
    {
      "Key": "VIP_002_DESCRIPTION_2",
      "String": "就習慣上來說不愛出門的人，有點社交焦慮，去戶外活動時總是會戴帽子，並抹上一堆防曬乳。"
    },
    {
      "Key": "VIP_002_DESCRIPTION_3",
      "String": "因為對貓過敏的關係只養狗，直到她為了首度造訪貓咪咖啡廳並陷入熱戀，才出現轉機。但熱戀對象是貓，不是約會對象。"
    },
    {
      "Key": "VIP_002_DESCRIPTION_4",
      "String": "她需要服用抗組織胺藥物才能去咖啡廳，但認為用打噴嚏作為抱貓的代價非常值得。定時撫摸貓，讓貓圍繞在身邊，可緩解她心中的焦慮。"
    },
    {
      "Key": "VIP_NAME_003",
      "String": "萊利"
    },
    {
      "Key": "VIP_OCCUPATION_003",
      "String": "酒保"
    },
    {
      "Key": "VIP_003_DESCRIPTION_1",
      "String": "頭上總是戴著毛帽，愛喝豆漿卡布奇諾，畢生強烈堅持貓優於狗的理論。"
    },
    {
      "Key": "VIP_003_DESCRIPTION_2",
      "String": "喜歡用臉磨蹭小貓的肚皮，最喜歡聽到貓發出的呼嚕嚕聲。"
    },
    {
      "Key": "VIP_003_DESCRIPTION_3",
      "String": "在與女友曲折的分手過程中，非常不幸喪失了摯愛貓咪「閃閃」的撫養權。"
    },
    {
      "Key": "VIP_003_DESCRIPTION_4",
      "String": "萊利在咖啡廳的貓身上找到了幸福與慰藉，希望有朝一日能像你一樣開間貓咪咖啡廳。"
    },
    {
      "Key": "VIP_NAME_004",
      "String": "俊熙"
    },
    {
      "Key": "VIP_OCCUPATION_004",
      "String": "平面設計師"
    },
    {
      "Key": "VIP_004_DESCRIPTION_1",
      "String": "俊熙喜歡設計並印製自己的品牌T恤，還有喝茶及踢足球。"
    },
    {
      "Key": "VIP_004_DESCRIPTION_2",
      "String": "他從來都不是愛貓人士，但在網路上注意到有多麼貓受到歡迎後，他來到咖啡廳想了解牠們，並嘗試將牠們加入自己的設計。"
    },
    {
      "Key": "VIP_004_DESCRIPTION_3",
      "String": "他對貓的態度從研究迅速轉變成喜愛。許多貓都認得他，會在他出現時開心地跳到他身邊，興奮地直發出呼嚕聲。"
    },
    {
      "Key": "VIP_004_DESCRIPTION_4",
      "String": "俊熙最近領養了一隻年紀較長的貓，以便在舒適的家中「研究」貓。他仍會不時造訪咖啡廳喝茶，抱抱他喜愛的貓咪。"
    },
    {
      "Key": "VIP_NAME_005",
      "String": "喬丹"
    },
    {
      "Key": "VIP_OCCUPATION_005",
      "String": "助理廚師"
    },
    {
      "Key": "VIP_005_DESCRIPTION_1",
      "String": "喬丹每星期的工作時數逼近60小時，因此他非常珍惜自己的下班時間。他大部分下班時間都在看動畫，以及和朋友一起玩電動遊戲。"
    },
    {
      "Key": "VIP_005_DESCRIPTION_2",
      "String": "喬丹非常努力工作，大部分原因是工作需求、償還就學貸款，以及存錢完成去日本旅行的夢想！"
    },
    {
      "Key": "VIP_005_DESCRIPTION_3",
      "String": "忙碌之餘，他也花時間學習日語，並得知貓咪咖啡廳便是起源於日本。除了聽說咖啡很好喝之外，這項資訊也激發他的興趣，吸引他來到了你的咖啡廳。"
    },
    {
      "Key": "VIP_005_DESCRIPTION_4",
      "String": "待在咖啡廳是喬丹唯一能真正放鬆的時候。雖然一開始這樣放鬆的快樂讓他心生內疚，但之後輕撫毛小孩成了他緩解壓力的活動！"
    },
    {
      "Key": "VIP_NAME_006",
      "String": "蘇茜"
    },
    {
      "Key": "VIP_OCCUPATION_006",
      "String": "彩妝師"
    },
    {
      "Key": "VIP_006_DESCRIPTION_1",
      "String": "天蠍座的蘇茜喜愛自拍，還有收聽關於中世紀歷史的播客。她最喜歡的顏色是黑色。"
    },
    {
      "Key": "VIP_006_DESCRIPTION_2",
      "String": "她是位白手起家的彩妝師，靠著成功的社群媒體經營以及對動物的熱愛，她創立了無動物實驗彩妝品牌。"
    },
    {
      "Key": "VIP_006_DESCRIPTION_3",
      "String": "受自己的貓「小水晶」所啟發，她最擅長化的是大膽的貓眼妝。眼線筆勾勒出的眼尾弧度就像黑曜石劍那般鋒利。"
    },
    {
      "Key": "VIP_006_DESCRIPTION_4",
      "String": "令人遺憾的是，小水晶最近已經去當小天使了。蘇茜因此來到咖啡廳，除了享受免費無線網路和美味點心外，也抱抱咖啡廳的貓咪新朋友。"
    },
    {
      "Key": "VIP_NAME_007",
      "String": "小凜"
    },
    {
      "Key": "VIP_OCCUPATION_007",
      "String": "音樂家"
    },
    {
      "Key": "VIP_007_DESCRIPTION_1",
      "String": "小凜喜歡唱卡拉OK，還喜歡把頭髮染成各種髮色，當然也對貓十分著迷。"
    },
    {
      "Key": "VIP_007_DESCRIPTION_2",
      "String": "她的休閒卡拉OK時光，後來激勵她展開了獨唱表演「穿西裝的貓」。她的音樂影響深遠，從古典樂到喉音唱法都有涉及。"
    },
    {
      "Key": "VIP_007_DESCRIPTION_3",
      "String": "小凜致力將關於貓的事物編進歌詞中，為了獲取靈感，她會讀文學著物來了解裡面的知名貓咪，也經常造訪咖啡館。"
    },
    {
      "Key": "VIP_007_DESCRIPTION_4",
      "String": "受咖啡館的貓咪所啟發，她發行了最新自創歌曲《貓抓板旋律》。這首歌在當地電台大獲成功，如今小凜已經是備受認可的明星了！"
    },
    {
      "Key": "VIP_NAME_008",
      "String": "潔達"
    },
    {
      "Key": "VIP_OCCUPATION_008",
      "String": "初級醫師"
    },
    {
      "Key": "VIP_008_DESCRIPTION_1",
      "String": "潔達是個學霸，以優異成績完成大學學業。擁有多個學位的她，最終決定將熱情奉獻於從醫助人。"
    },
    {
      "Key": "VIP_008_DESCRIPTION_2",
      "String": "工作以外的時間，潔達喜歡去慈善二手商店購物、肆意喝咖啡，以及在當地貓咪收容所當志工。"
    },
    {
      "Key": "VIP_008_DESCRIPTION_3",
      "String": "潔達從小就非常善良，她總是率先對人伸出援手，無論對方是朋友還是陌生人。"
    },
    {
      "Key": "VIP_008_DESCRIPTION_4",
      "String": "無私與忙碌的生活使得潔達無暇養貓。因此她盡可能造訪咖啡館，滿足迫切想抱抱貓咪的渴望。"
    },
    {
      "Key": "VIP_NAME_009",
      "String": "里昂"
    },
    {
      "Key": "VIP_OCCUPATION_009",
      "String": "雜貨店老闆"
    },
    {
      "Key": "VIP_009_DESCRIPTION_1",
      "String": "里昂將為動物發聲視為首要之務。除了為正義努力之外，他的工作就是在自己開的「美喵食品」商店販售當地食品。"
    },
    {
      "Key": "VIP_009_DESCRIPTION_2",
      "String": "「小鈕扣」是他領養的貓，當初被人發現時一直嚎叫，且相當害怕。小鈕扣獨自生活在里昂的店裡，怕生的個性曾使他乏人問津好一陣子。"
    },
    {
      "Key": "VIP_009_DESCRIPTION_3",
      "String": "如今，小鈕扣和里昂享受著安靜又愉快的生活，每位來店裡的常客都會熱絡地向他們打招呼。"
    },
    {
      "Key": "VIP_009_DESCRIPTION_4",
      "String": "里昂非常喜歡去你的咖啡館，見證貓咪被領養的喜悅時刻。他支持許多與貓有關的慈善活動，並且會來咖啡館力行支持與推廣！"
    },
    {
      "Key": "VIP_NAME_010",
      "String": "魯柏"
    },
    {
      "Key": "VIP_OCCUPATION_010",
      "String": "自由接案程式設計師"
    },
    {
      "Key": "VIP_010_DESCRIPTION_1",
      "String": "魯柏無意遵循一般成年人所走的傳統道路，他更喜歡自由自在地生活。他隨心所欲決定自己的工作地點和時間。"
    },
    {
      "Key": "VIP_010_DESCRIPTION_2",
      "String": "魯柏在朋友的眼中是有點叛逆的人，但他內心其實既細膩又體貼。他喜愛動物，有隻名叫「迪諾」的寵物鼠。"
    },
    {
      "Key": "VIP_010_DESCRIPTION_3",
      "String": "魯柏擔心養貓咪會讓迪諾不開心，而且深信這兩種動物無法共處。為了私下享受親近貓咪的感覺，他會造訪咖啡館。"
    },
    {
      "Key": "VIP_010_DESCRIPTION_4",
      "String": "這是他唯一的例行公事。因為實在太喜歡來貓咪咖啡館，他創立了藝術部落格，發佈關於店內貓咪的粉絲創作！"
    },
    {
      "Key": "VIP_NAME_011",
      "String": "路卡"
    },
    {
      "Key": "VIP_OCCUPATION_011",
      "String": "圖書館館員"
    },
    {
      "Key": "VIP_011_DESCRIPTION_1",
      "String": "路卡從小就非常喜愛閱讀，他的生活離不開文學。他最喜歡的體裁是超自然愛情故事。"
    },
    {
      "Key": "VIP_011_DESCRIPTION_2",
      "String": "路卡從16歲開始就在當地圖書館工作，從那時起就和圖書館館貓「大胖」成了摯友。他的夢想是成為暢銷作家。"
    },
    {
      "Key": "VIP_011_DESCRIPTION_3",
      "String": "二十歲出頭時，路卡因故成了聽障人士。他喜歡在下班後教授手語課。大胖也樂得享受手語課學生的摸摸。"
    },
    {
      "Key": "VIP_011_DESCRIPTION_4",
      "String": "有學生向路卡推薦了你的咖啡館。自從第一次造訪後，他就開始撰寫自己的第一本小說！小說的靈感來自你的咖啡館所散發的幸福感。"
    },
