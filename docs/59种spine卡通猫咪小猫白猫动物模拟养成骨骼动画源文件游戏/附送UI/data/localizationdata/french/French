      "Key": "VIP_NAME_001",
      "String": "Cerise"
    },
    {
      "Key": "VIP_OCCUPATION_001",
      "String": "Bloggeuse"
    },
    {
      "Key": "VIP_001_DESCRIPTION_1",
      "String": "Aime les plantes d'intérieur, est accro à la téléréalité et boit trop de café noir."
    },
    {
      "Key": "VIP_001_DESCRIPTION_2",
      "String": "Le chat qu'elle avait enfant, Max, était son meilleur ami. Elle lui murmurait tous ses secrets."
    },
    {
      "Key": "VIP_001_DESCRIPTION_3",
      "String": "Inspirée par Max, elle est devenue végétarienne assez jeune. Elle veut que tous les animaux soient chouchoutés."
    },
    {
      "Key": "VIP_001_DESCRIPTION_4",
      "String": "Quand Max est morte, elle a juré de ne plus avoir de chat, mais de se consacrer à sauver des chats dans le besoin. Elle vient au café pour profiter de leurs bêtes à poils... Et de leur café."
    },
    {
      "Key": "VIP_NAME_002",
      "String": "Sarah"
    },
    {
      "Key": "VIP_OCCUPATION_002",
      "String": "Dessinatrice"
    },
    {
      "Key": "VIP_002_DESCRIPTION_1",
      "String": "Aime jouer à des jeux vidéo, est très douce, tendre, et utilise plein d'émojis dans ses textos."
    },
    {
      "Key": "VIP_002_DESCRIPTION_2",
      "String": "Peu adepte des passe-temps d'extérieur, un peu timide, elle ne sort jamais sans son chapeau et beaucoup de crème solaire."
    },
    {
      "Key": "VIP_002_DESCRIPTION_3",
      "String": "N'aimait que les chiens à cause d'allergies aux poils de chat, jusqu'à ce qu'elle aille dans un café à chat pour un premier rendez-vous, et tombe amoureuse. Des chats, pas de son rendez-vous."
    },
    {
      "Key": "VIP_002_DESCRIPTION_4",
      "String": "A besoin d'antihistaminiques pour venir au café à chats, mais sait que les éternuements justifient largement les câlins. Les caresses et la présence des chats calment son angoisse."
    },
    {
      "Key": "VIP_NAME_003",
      "String": "Riley"
    },
    {
      "Key": "VIP_OCCUPATION_003",
      "String": "Barman"
    },
    {
      "Key": "VIP_003_DESCRIPTION_1",
      "String": "Porte toujours un bonnet, aime les bons capuccino au soja, et soutiendra mordicus que les chats sont supérieurs aux chiens."
    },
    {
      "Key": "VIP_003_DESCRIPTION_2",
      "String": "Aime fourre le nez sur le ventre des chatons, et adore les chats qui poussent des petits miaulements d'oiseau."
    },
    {
      "Key": "VIP_003_DESCRIPTION_3",
      "String": "A tragiquement perdu la garde de son chat adoré, Sparkle, lors d'une rupture compliquée avec sa petite amie."
    },
    {
      "Key": "VIP_003_DESCRIPTION_4",
      "String": "Trouve le bonheur et la consolation dans les chats du café, et espère un jour en ouvrir un à son tour."
    },
    {
      "Key": "VIP_NAME_004",
      "String": "Jun Seo"
    },
    {
      "Key": "VIP_OCCUPATION_004",
      "String": "Concepteur graphique"
    },
    {
      "Key": "VIP_004_DESCRIPTION_1",
      "String": "Jun Seo est passionné par la création et l'impression de tee-shirts de sa marque. Il aime aussi le thé et jouer au foot."
    },
    {
      "Key": "VIP_004_DESCRIPTION_2",
      "String": "Il n'a jamais été un fan de chats, mais en découvrant leur popularité sur Internet, il est venu au café pour en apprendre plus sur eux, et il a cherché à les intégrer à ses créations."
    },
    {
      "Key": "VIP_004_DESCRIPTION_3",
      "String": "Sa recherche s'est vite transformée en amour. Beaucoup de chats le reconnaissent et bondissent vers lui dès qu'il arrive, ronronnant d'excitation."
    },
    {
      "Key": "VIP_004_DESCRIPTION_4",
      "String": "Jun Seo a récemment adopté son propre chat adulte pour faire des « recherches » depuis chez lui. Il vient encore au café pour son thé habituel et pour les câlins des chats qu'il a appris à aimer."
    },
    {
      "Key": "VIP_NAME_005",
      "String": "Jordan"
    },
    {
      "Key": "VIP_OCCUPATION_005",
      "String": "Chef adjoint"
    },
    {
      "Key": "VIP_005_DESCRIPTION_1",
      "String": "Jordan travaille jusqu'à 60 heures par semaine et apprécie vraiment son temps de repos. Il le passe surtout à regarder des dessins animées et à jouer aux jeux vidéo avec ses amis."
    },
    {
      "Key": "VIP_005_DESCRIPTION_2",
      "String": "Jordan travaille beaucoup, du fait de son type d'activité, mais aussi pour rembourser son prêt étudiant et économiser pour le voyage de ses rêves au Japon !"
    },
    {
      "Key": "VIP_005_DESCRIPTION_3",
      "String": "Bien que très occupé, il étudie le Japonais et a découvert que les cafés à chats viennent du Japon."
    },
    {
      "Key": "VIP_005_DESCRIPTION_4",
      "String": "Il n'arrive à vraiment se détendre qu'au café. Ce qui avait commencé comme un plaisir coupable, caresser ses amis à fourrure, est devenu l'activité relaxante de Jordan !"
    },
