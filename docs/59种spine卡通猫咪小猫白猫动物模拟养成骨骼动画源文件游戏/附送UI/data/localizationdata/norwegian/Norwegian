    },
    {
      "Key": "VIP_001_DESCRIPTION_1",
      "String": "Kari elsker potteplanter, er avhengig av reality-TV og drikker for mye svart kaffe."
    },
    {
      "Key": "VIP_001_DESCRIPTION_2",
      "String": "Da hun var liten, var katten Max hennes beste venn. Hun hvisket alle hemmelighetene sine til ham."
    },
    {
      "Key": "VIP_001_DESCRIPTION_3",
      "String": "Hun har vært veganer fra barndommen. Hun vil at alle dyr skal elskes og settes pris på."
    },
    {
      "Key": "VIP_001_DESCRIPTION_4",
      "String": "Da Max døde, sverget hun at hun aldri skulle ha katt igjen, og heller skulle vie tiden sin til katter som trengte det. Hun kommer stadig innom kafeen for å få litt kattekjærlighet og koffein."
    },
    {
      "Key": "VIP_NAME_002",
      "String": "Sarah"
    },
    {
      "Key": "VIP_OCCUPATION_002",
      "String": "2D-kunstner"
    },
    {
      "Key": "VIP_002_DESCRIPTION_1",
      "String": "Sarah elsker å spille dataspill og er snill og omtenksom. Hun bruker alltid mange utrykksikoner i tekstmeldingene sine."
    },
    {
      "Key": "VIP_002_DESCRIPTION_2",
      "String": "Hun er tradisjonelt en innendørsperson, litt sosialt usikker og har alltid på seg hatt og masse solkrem når hun går ut."
    },
    {
      "Key": "VIP_002_DESCRIPTION_3",
      "String": "Tidligere likte Sarah bare hunder på grunn av katteallergi, men da hun dro innom sin første kattekafé, ble hun forelsket. I kattene, ikke han hun var på date med."
    },
    {
      "Key": "VIP_002_DESCRIPTION_4",
      "String": "Hun må ta allergimedisin for å gå på kafeen, men hun synes det er verdt det for å få være sammen med kattene. Hun blir litt mindre nervøs av å ha katter rundt seg."
    },
    {
      "Key": "VIP_NAME_003",
      "String": "Ronny"
    },
    {
      "Key": "VIP_OCCUPATION_003",
      "String": "Bartender"
    },
    {
      "Key": "VIP_003_DESCRIPTION_1",
      "String": "Ronny har alltid på seg lue, elsker en god soyacappucino og er fast bestemt på at katter er bedre enn hunder."
    },
    {
      "Key": "VIP_003_DESCRIPTION_2",
      "String": "Han elsker å klemme ansiktet mot kattene og å høre at de lager malelyder."
    },
    {
      "Key": "VIP_003_DESCRIPTION_3",
      "String": "Han mistet sin egen katt, Spragle, da han gjorde det slutt med kjæresten og hun insisterte på å beholde katten."
    },
    {
      "Key": "VIP_003_DESCRIPTION_4",
      "String": "Ronny blir lykkelig av å være sammen med kattene på kafeen. Han håper en gang å kunne åpne et sted fullt av glede og lykke, akkurat som stedet ditt."
    },
    {
      "Key": "VIP_NAME_004",
      "String": "Jun Seo"
    },
    {
      "Key": "VIP_OCCUPATION_004",
      "String": "Grafisk designer"
    },
    {
      "Key": "VIP_004_DESCRIPTION_1",
      "String": "Jun Seos lidenskap ligger i å designe og trykke sine egne T-skjorter, i tillegg til å drikke te og spille fotball."
    },
    {
      "Key": "VIP_004_DESCRIPTION_2",
      "String": "Han har aldri vært en katteperson, men da han oppdaget hvor populære kattene var på internett, kom han innom kafeen for å lære mer om dem og bruke dem på T-skjortene sine."
    },
    {
      "Key": "VIP_004_DESCRIPTION_3",
      "String": "Research-prosjektet hans gikk snart over i kjærlighet. Mange av kattene kjenner ham igjen, og kommer bort til ham og maler når han kommer."
    },
    {
      "Key": "VIP_004_DESCRIPTION_4",
      "String": "Jun Seo har nylig adoptert en egen eldre katt han kan «gjøre research på hjemme», men han kommer fremdeles innom kafeen for å drikke te og kose med kattene han har blitt glad i."
    },
    {
      "Key": "VIP_NAME_005",
      "String": "Jordan"
    },
    {
      "Key": "VIP_OCCUPATION_005",
      "String": "Assistentkokk"
    },
    {
      "Key": "VIP_005_DESCRIPTION_1",
      "String": "Jordan jobber opptil 60 timer i uken, og setter stor pris på hvert minutt han har fri. Tiden går stort sett med til å se på japanske tegnefilmer og å spille dataspill med vennene sine."
    },
    {
      "Key": "VIP_005_DESCRIPTION_2",
      "String": "Grunnen til at Jordan jobber så mye er at karrieren krever det og at han betaler ned studielånet samtidig som han sparer til en drømmetur til Japan!"
    },
    {
      "Key": "VIP_005_DESCRIPTION_3",
      "String": "Til tross for at han er så travel, studerer han japansk, og har oppdaget at kattekafeene først dukket opp i Japan. Og da han hørte om at du serverte god kaffe, tok han turen innom."
    },
    {
      "Key": "VIP_005_DESCRIPTION_4",
      "String": "Kafeen er det eneste stedet han slapper skikkelig av. Selv om han til å begynne med ikke var så interessert i kattene, har Jordan etter hvert funnet ut at det virker beroligende å klappe dem."
    },
    {
      "Key": "VIP_NAME_006",
      "String": "Suzy"
    },
    {
      "Key": "VIP_OCCUPATION_006",
      "String": "Stylist"
    },
    {
      "Key": "VIP_006_DESCRIPTION_1",
      "String": "Suzy er født i Skorpionen og elsker å ta selfier og høre på podcaster om middelalderen. Hun elsker alt som er svart."
    },
    {
      "Key": "VIP_006_DESCRIPTION_2",
      "String": "Hun er selvlært stylist, og suksessen hennes på sosiale medier og kjærligheten for dyr har gjort det mulig for henne å etablere sitt eget sminkemerke som ikke bruker dyreforsøk."
    },
    {
      "Key": "VIP_006_DESCRIPTION_3",
      "String": "Hun henter inspirasjon fra sin egen katt, Pebbles, og spesialiteten hennes er å sminke katteøyne. Linjene hun tegner er så skarpe som et sverd av obsidian."
    },
    {
      "Key": "VIP_006_DESCRIPTION_4",
      "String": "Dessverre døde Pebbles nylig av alderdom, så nå kommer Suzy til kafeen for å bruke nettet, ta seg noe å drikke og kose med de nye kafékattevennene sine."
    },
    {
      "Key": "VIP_NAME_007",
      "String": "Rin"
    },
    {
      "Key": "VIP_OCCUPATION_007",
      "String": "Musiker"
    },
    {
      "Key": "VIP_007_DESCRIPTION_1",
      "String": "Rin elsker karaoke, har farget håret sitt i alle tenkelige farger og er selvsagt besatt av katter."
    },
    {
      "Key": "VIP_007_DESCRIPTION_2",
      "String": "Etter å ha holdt på med karaoke lenge, bestemte hun seg for å bli artist på ordentlig, med soloprosjektet «Katter i dress». Hun er inspirert av forskjellige sjangre, alt fra klassisk musikk til strupesang."
    },
    {
      "Key": "VIP_007_DESCRIPTION_3",
      "String": "Rin prøver å få mest mulig innhold om katter i sangene sine, og henter inspirasjon fra berømte katter i litteraturen og hyppige besøk på kafeen."
    },
    {
      "Key": "VIP_007_DESCRIPTION_4",
      "String": "Den nyeste sangen hennes, «Støl av klorestokken», har blitt populær på lokale radiostasjoner, og hun er nå en anerkjent stjerne!"
    },
    {
      "Key": "VIP_NAME_008",
