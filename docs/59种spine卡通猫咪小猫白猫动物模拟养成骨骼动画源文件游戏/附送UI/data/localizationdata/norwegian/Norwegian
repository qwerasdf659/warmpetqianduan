    {
      "Key": "VIP_OCCUPATION_008",
      "String": "Lege"
    },
    {
      "Key": "VIP_008_DESCRIPTION_1",
      "String": "Jada har alltid fått toppkarakterer og suste gjennom universitetsstudiene på null komma niks. Hun har flere grader, men har bestemt seg for at hun vil vie livet sitt til å hjelpe folk som lege."
    },
    {
      "Key": "VIP_008_DESCRIPTION_2",
      "String": "Når hun ikke jobber, elsker Jada å gå i bruktbutikker, drikke så mye kaffe som mulig og å arbeide frivillig for herreløse katter som trenger hjelp."
    },
    {
      "Key": "VIP_008_DESCRIPTION_3",
      "String": "Jada har alltid vært snill og omtenksom og er alltid den første som tilbyr seg å hjelpe dem som trenger det, om det er noen hun kjenner eller en fremmed."
    },
    {
      "Key": "VIP_008_DESCRIPTION_4",
      "String": "Den travle livsstilen gjør det umulig for henne å ha en egen katt, så Jada prøver å komme innom kafeen så ofte som mulig, for å kose med kattene der."
    },
    {
      "Key": "VIP_NAME_009",
      "String": "Leon"
    },
    {
      "Key": "VIP_OCCUPATION_009",
      "String": "Matbutikkeier"
    },
    {
      "Key": "VIP_009_DESCRIPTION_1",
      "String": "Leon er først og fremst en forkjemper for dyrenes rettigheter. Men når han ikke kjemper for rettferdighet, jobber han med å selge lokale produkter i butikken sin «Perfekte Produkter»."
    },
    {
      "Key": "VIP_009_DESCRIPTION_2",
      "String": "Den adopterte katten hans, Button, var i elendig forfatning da Leon fant ham, etter å ha levd alene under butikken i lang tid."
    },
    {
      "Key": "VIP_009_DESCRIPTION_3",
      "String": "Nå har Button og Leon et rolig liv sammen, og begge blir behandlet som gamle venner av de faste kundene i butikken."
    },
    {
      "Key": "VIP_009_DESCRIPTION_4",
      "String": "Leon liker å ta turen innom kafeen for å hilse på de nye kattene som blir adoptert."
    },
    {
      "Key": "VIP_NAME_010",
      "String": "Rupert"
    },
    {
      "Key": "VIP_OCCUPATION_010",
      "String": "Frilansprogrammerer"
    },
    {
      "Key": "VIP_010_DESCRIPTION_1",
      "String": "Rupert er ikke interessert i vanlig voksenansvar og foretrekker heller å leve et fritt liv."
    },
    {
      "Key": "VIP_010_DESCRIPTION_2",
      "String": "Vennene hans synes kanskje han er litt opprørsk, men egentlig er han en følsom fyr med et stort hjerte. Han elsker dyr, og har en kjælerotte som heter Dino."
    },
    {
      "Key": "VIP_010_DESCRIPTION_3",
      "String": "Han er bekymret for at Dino ikke ville likt at han hadde en egen katt, og det er vel rimelig å anta at de ikke hadde gått så godt overens."
    },
    {
      "Key": "VIP_010_DESCRIPTION_4",
      "String": "Dette er den eneste rutinen han har i livet, og han synes det er så givende at han har laget en egen blogg der ha deler tegninger han har tegnet av kattene på kafeen!"
    },
    {
      "Key": "VIP_NAME_011",
      "String": "Luca"
    },
    {
      "Key": "VIP_OCCUPATION_011",
      "String": "Bibliotekar"
    },
    {
      "Key": "VIP_011_DESCRIPTION_1",
      "String": "Luca har elsket å lese siden han var liten, og er alltid omgitt av litteratur. Favorittsjangeren hans er overnaturlig romantikk."
    },
    {
      "Key": "VIP_011_DESCRIPTION_2",
      "String": "Den lokale bibliotekkatten, Behemoth, har vært en av de beste vennene hans siden han begynte å jobbe på biblioteket da han var 16. Lucas drøm er å bli en bestselgende forfatter."
    },
    {
      "Key": "VIP_011_DESCRIPTION_3",
      "String": "Luca ble døv tidlig i tjueårene, og har ekstrajobb med å lære bort tegnspråk på fritiden. Behemoth liker å bli klappet av elevene."
    },
    {
      "Key": "VIP_011_DESCRIPTION_4",
      "String": "En av elevene anbefalte å sjekke ut kafeen, og siden Luca begynte å komme innom, har han begynt å skrive på sin første roman! Den er inspirert av den gode stemningen på kafeen."
    },
    {
      "Key": "VIP_NAME_012",
      "String": "Jiyoo"
    },
    {
      "Key": "VIP_OCCUPATION_012",
