#///////////////////////////
# Cocos Creator Project
#///////////////////////////

/library/
/temp/
/local/
/build/
/profiles/
/native/engine/android/**/*/assets

#//////////////////////////
# NPM
#//////////////////////////
node_modules/

#//////////////////////////
# 编辑器扩展
#//////////////////////////
# cocos-creator-mcp 是指向 C:\tools 的目录联接，本体有自己的仓库，不进这里
/extensions/

#//////////////////////////
# 编辑器
#//////////////////////////
.vscode/
.idea/

#//////////////////////////
# 资产管线的中间产物
#//////////////////////////
# 实验产物一律写这里，不要写 temp/——那是 Cocos 自己的目录，
# 「预览坏掉就删 temp/」的恢复流程会把中间产物一起删掉。
# 哪份产物是当前出包的那份，以 assets-src/BUILD.json 为准。
/.build/

# Python 字节码。之前有 4 个 .pyc 混进过仓库。
__pycache__/
*.py[cod]

#//////////////////////////
# 本机相关、不进仓库的生成物
#//////////////////////////
# 由 _research/typecheck.mjs 按本机 Creator 安装位置生成
/_research/tsconfig.check.local.json

#//////////////////////////
# 不该进仓库的大文件
#//////////////////////////
*.exe
